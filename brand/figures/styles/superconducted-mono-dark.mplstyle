# SuperconducTED chart style: Monochrome, dark ground.
# Generated by brand/figures/build_styles.py from brand/tools/palettes.py.
# Do not edit by hand: change palettes.py or the generator and run it again.
#
# Chart roles (roles.json holds them too; superconducted_figures.py draws with them):
#   band fill  #2C2E31  the interval band, a solid 20 percent tint of the accent
#   band edge  #9AA0A6  the band's bounds (the accent: the range, nothing else)
#   crisp      #F7F7F5  the single-snapshot line, dashed (ink: the machine)
#   measured   #F7F7F5  the hardware's points, ringed in the ground colour
#   series     #D95926 #3987E5 #169C6F #877CDF #C98500 #D34F80
#              (orange, blue, aqua, violet, yellow, magenta; per-qubit identity, fixed order)
#
# Fonts: Space Grotesk for text, Space Mono as the monospace face (tick labels through
# superconducted_figures.mono_ticks); DejaVu Sans and DejaVu Sans Mono, which ship with
# matplotlib, stand in silently where the brand fonts are not installed.

font.family: sans-serif
font.sans-serif: Space Grotesk, DejaVu Sans
font.monospace: Space Mono, DejaVu Sans Mono
font.size: 10
text.color: F7F7F5

figure.facecolor: 111214
figure.edgecolor: 111214
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.1
figure.constrained_layout.w_pad: 0.08
figure.titlesize: 13
figure.titleweight: bold
savefig.facecolor: 111214
savefig.edgecolor: 111214
savefig.dpi: 200
svg.hashsalt: superconducted
pdf.fonttype: 42
ps.fonttype: 42

axes.facecolor: 111214
axes.edgecolor: 626263
axes.linewidth: 0.8
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.spines.bottom: True
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.labelcolor: F7F7F5
axes.labelsize: 10
axes.labelpad: 6
axes.titlecolor: F7F7F5
axes.titlesize: 11
axes.titleweight: normal
axes.titlelocation: left
axes.titlepad: 10
axes.prop_cycle: cycler('color', ['D95926', '3987E5', '169C6F', '877CDF', 'C98500', 'D34F80'])

grid.color: 2D2D2F
grid.linestyle: -
grid.linewidth: 0.6
grid.alpha: 1.0

xtick.color: 626263
xtick.labelcolor: A0A0A0
xtick.labelsize: 8.5
xtick.direction: out
xtick.major.size: 3.5
xtick.major.width: 0.8
xtick.minor.visible: False
ytick.color: 626263
ytick.labelcolor: A0A0A0
ytick.labelsize: 8.5
ytick.major.size: 0
ytick.major.pad: 5
ytick.minor.visible: False

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: F7F7F5
legend.handlelength: 1.8
legend.borderaxespad: 0.4

lines.linewidth: 1.5
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.dash_capstyle: butt
lines.dashed_pattern: 3.2, 2.0
lines.markersize: 6
lines.markeredgewidth: 1.2
patch.linewidth: 1.0
