# SuperconducTED chart style: Phosphor, light ground.
# Generated by brand/figures/build_styles.py from brand/tools/palettes.py.
# Do not edit by hand: change palettes.py or the generator and run it again.
#
# Chart roles (roles.json holds them too; superconducted_figures.py draws with them):
#   band fill  #C1DACD  the interval band, a solid 20 percent tint of the accent
#   band edge  #0B7446  the band's bounds (the accent: the range, nothing else)
#   crisp      #0B1410  the single-snapshot line, dashed (ink: the machine)
#   measured   #0B1410  the hardware's points, ringed in the ground colour
#   series     #BD7F00 #D36992 #4A3AA7 #B63F00 #2A78D6 #C62B30
#              (yellow, magenta, violet, orange, blue, red; per-qubit identity, fixed order)
#
# Fonts: Space Grotesk for text, Space Mono as the monospace face (tick labels through
# superconducted_figures.mono_ticks); DejaVu Sans and DejaVu Sans Mono, which ship with
# matplotlib, stand in silently where the brand fonts are not installed.

font.family: sans-serif
font.sans-serif: Space Grotesk, DejaVu Sans
font.monospace: Space Mono, DejaVu Sans Mono
font.size: 10
text.color: 0B1410

figure.facecolor: EEF3EF
figure.edgecolor: EEF3EF
figure.constrained_layout.use: True
figure.constrained_layout.h_pad: 0.1
figure.constrained_layout.w_pad: 0.08
figure.titlesize: 13
figure.titleweight: bold
savefig.facecolor: EEF3EF
savefig.edgecolor: EEF3EF
savefig.dpi: 200
svg.hashsalt: superconducted
pdf.fonttype: 42
ps.fonttype: 42

axes.facecolor: EEF3EF
axes.edgecolor: 868C88
axes.linewidth: 0.8
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.spines.bottom: True
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.labelcolor: 0B1410
axes.labelsize: 10
axes.labelpad: 6
axes.titlecolor: 0B1410
axes.titlesize: 11
axes.titleweight: normal
axes.titlelocation: left
axes.titlepad: 10
axes.prop_cycle: cycler('color', ['BD7F00', 'D36992', '4A3AA7', 'B63F00', '2A78D6', 'C62B30'])

grid.color: D3D8D4
grid.linestyle: -
grid.linewidth: 0.6
grid.alpha: 1.0

xtick.color: 868C88
xtick.labelcolor: 4B524E
xtick.labelsize: 8.5
xtick.direction: out
xtick.major.size: 3.5
xtick.major.width: 0.8
xtick.minor.visible: False
ytick.color: 868C88
ytick.labelcolor: 4B524E
ytick.labelsize: 8.5
ytick.major.size: 0
ytick.major.pad: 5
ytick.minor.visible: False

legend.frameon: False
legend.fontsize: 9
legend.labelcolor: 0B1410
legend.handlelength: 1.8
legend.borderaxespad: 0.4

lines.linewidth: 1.5
lines.solid_capstyle: round
lines.solid_joinstyle: round
lines.dash_capstyle: butt
lines.dashed_pattern: 3.2, 2.0
lines.markersize: 6
lines.markeredgewidth: 1.2
patch.linewidth: 1.0
